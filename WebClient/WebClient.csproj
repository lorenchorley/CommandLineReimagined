<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommandLineReimagined.WebClient</RootNamespace>

    <!--
      The whole point of this project is to run the real GOLD parser in the browser
      with no server behind it, so payload size is the binding constraint.
      InvariantGlobalization drops the ~1.1 MB ICU table, and the debug symbols are
      dead weight in a static deployment.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      Terminal.dll embeds 20.4 MB of CommandSearch synonym data. Only the grammar is
      needed here, and 20 MB over a phone connection is not a demo.

      CAUTION: building this project writes a search-data-free Terminal.dll into the
      shared CommandLine/bin, and MSBuild's up-to-date check does not notice that the
      property changed. A later incremental build of the desktop app in the same tree
      can therefore silently pick up a Terminal.dll whose CommandSearch resources are
      missing. Run `dotnet build CommandLine/Terminal.csproj -t:Rebuild` after working
      on this project. CI is unaffected: the wasm job uses a clean checkout.
    -->
    <ExcludeSearchData>true</ExcludeSearchData>

    <!--
      The static host reserves paths beginning with "_", so the framework directory is
      relocated from _framework to framework after publish. Rewriting the loader's
      paths invalidates the integrity hashes, so they are turned off here.
    -->
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Web.Core\Web.Core.csproj" />
  </ItemGroup>

</Project>
