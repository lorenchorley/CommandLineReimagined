<Project>

  <!--
    Central package management: every version lives here, and project files reference
    packages by name alone.

    Before this, five test projects carried four different MSTest versions and three
    different test SDK versions, one of them a preview. Upgrading meant editing the
    same version in a dozen files and missing some. Now a dependency is upgraded once.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Blazor WebAssembly">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Language and parsing">
    <!--
      FSharp.Core is normally supplied implicitly by the SDK, at the version the F#
      compiler in that SDK was built against, which it ships as a local library pack.
      Central transitive pinning overrides that with whatever the graph's lowest
      requirement is, and FParsec asks for 4.3.4: a version predating string
      interpolation, so the core would not compile against it.

      Naming it here puts it back under our control. Keep it at the SDK's own version
      (FSCorePackageVersion in its Microsoft.FSharp.Core.NetSdk.props) so the implicit
      reference and the pin agree; when they disagree the browser build links against
      one and runs against the other, which shows up as a missing method or an
      unresolvable type at startup rather than as a build error.
    -->
    <PackageVersion Include="FSharp.Core" Version="10.0.112" />
    <!--
      FParsec 2.0.0-beta exists. The parser is the project's foundation and its tests
      pin exact error columns, so it stays on the released line until someone has time
      to read that release's notes properly.
    -->
    <PackageVersion Include="FParsec" Version="1.1.1" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="OneOf.SourceGenerator" Version="3.0.271" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
