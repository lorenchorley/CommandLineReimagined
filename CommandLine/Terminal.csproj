<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Commands\Parser\Grammar\CommandLineGrammar.egt" />
    <None Remove="Commands\Parser\Grammar\IsValidIdentifier.egt" />
    <None Remove="Search\dictionary-en.csv" />
    <None Remove="Search\en_thesaurus.jsonl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Commands\Parser\Grammar\CommandLineGrammar.egt" />
    <EmbeddedResource Include="Commands\Parser\Grammar\IsValidIdentifier.egt" />

    <!--
      CommandSearch's synonym data, 20.4 MB across the two files. Embedding them made
      Terminal.dll 20.5 MB, which every consumer paid for. They are copied next to the
      assembly instead and loaded from disk, so the assembly stays around 130 KB and a
      host that does not want them (the WebAssembly client) simply does not ship them.
      CommandSearch treats their absence as "synonym search unavailable", not an error.
    -->
    <Content Include="Search\dictionary-en.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Search\en_thesaurus.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GoldEngine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="OneOf" />
    <PackageReference Include="OneOf.SourceGenerator" />
    <PackageReference Include="ValueOf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parser.Tree\Parser.Tree.csproj" />
    <ProjectReference Include="..\Controller\Controller.csproj" />
    <ProjectReference Include="..\EntityComponentSystem\EntityComponentSystem.csproj" />
    <ProjectReference Include="..\InteractionLogic\Interaction.csproj" />
    <ProjectReference Include="..\RayCasting\RayCasting.csproj" />
    <ProjectReference Include="..\VisualInterface\UIComponents.csproj" />
	  <ProjectReference Include="..\SourceGenerators\SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Prompt\" />
    <ProjectReference Include="..\Parser.FParsec\Parser.FParsec.fsproj" />
  </ItemGroup>

</Project>
