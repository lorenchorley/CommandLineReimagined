<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommandLineReimagined.Web</RootNamespace>
    <AssemblyName>Web.Core</AssemblyName>
  </PropertyGroup>

  <!--
    The adapter between the F# core and the two front ends: the ASP.NET host (Web)
    and the WebAssembly client (WebClient). It maps a Session's values to JSON DTOs
    and shares one tokeniser, so both front ends produce an identical token stream.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.fsproj" />
    <ProjectReference Include="..\Parser.FParsec\Parser.FParsec.fsproj" />
  </ItemGroup>

</Project>
