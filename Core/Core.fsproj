<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The functional core (decision 0006): values, faults, the store, the commands and
    the session. It depends on the parser and on nothing else. Nothing in here knows
    about the ECS, rendering, WPF, Blazor or JavaScript, which is what lets the same
    semantics run in a browser tab and in a desktop window.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CommandLineReimagined.Core</AssemblyName>
    <RootNamespace>CommandLineReimagined.Core</RootNamespace>
    <!-- Structural equality and comparison on these types is never used. -->
    <NoWarn>$(NoWarn);FS0064</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    F# compiles in the order listed, and a file may only use what came before it. The
    order is the dependency order of the design: failure, then values (a fault is one,
    from Phase 5), then the log, then the fold over it, then the things that read the
    fold.
  -->
  <ItemGroup>
    <Compile Include="Faults.fs" />
    <Compile Include="Values.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Table.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="Csv.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Scope.fs" />
    <Compile Include="Tree.fs" />
    <Compile Include="Expr.fs" />
    <Compile Include="Commands/Spec.fs" />
    <Compile Include="Binder.fs" />
    <Compile Include="Commands/Files.fs" />
    <Compile Include="Commands/Values.fs" />
    <Compile Include="Commands/Async.fs" />
    <Compile Include="Commands/Tables.fs" />
    <Compile Include="Commands/Documents.fs" />
    <Compile Include="Commands/Meta.fs" />
    <Compile Include="Nearest.fs" />
    <Compile Include="Evaluator.fs" />
    <!--
      Phase 8: completion reads the line. `Context` says where the cursor is, each
      provider answers one kind of place, and `Completion.fs` dispatches between them.
      Every file a stream builds is registered here now, so no stream edits this file.
    -->
    <Compile Include="Completion/Summary.fs" />
    <Compile Include="Completion/Context.fs" />
    <Compile Include="Completion/Shape.fs" />
    <Compile Include="Completion/Request.fs" />
    <Compile Include="Completion/Lexical.fs" />
    <Compile Include="Completion/Commands.fs" />
    <Compile Include="Completion/Variables.fs" />
    <Compile Include="Completion/Paths.fs" />
    <Compile Include="Completion/Arguments.fs" />
    <Compile Include="Completion/Predicates.fs" />
    <Compile Include="Completion/Hover.fs" />
    <Compile Include="Completion.fs" />
    <Compile Include="Seed.fs" />
    <Compile Include="Session.fs" />
  </ItemGroup>

  <!--
    The four example programs travel with the core, so the hosted build seeds them into
    /examples and can run them as they stand. They are the plan's proof that the design
    works end to end, and a proof that only exists in the test project is one nobody can
    try for themselves.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\examples\*.clr" LogicalName="examples/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parser.Tree\Parser.Tree.csproj" />
    <ProjectReference Include="..\Parser.FParsec\Parser.FParsec.fsproj" />
  </ItemGroup>

</Project>
